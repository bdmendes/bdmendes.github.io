---
import { type CollectionEntry, getCollection } from "astro:content";
import { createSlug } from "../../lib/util";
import ArtifactLayout from "@layouts/ArtifactLayout.astro";

export async function getStaticPaths() {
  const artifactEntries = await getCollection("artifacts");
  return artifactEntries.map((entry) => ({
    params: { slug: createSlug(entry.data.title) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"artifacts">;
}

const { entry } = Astro.props;
---

<ArtifactLayout title={entry.data.title} body={entry.body ?? ""} description={entry.data.description} url={entry.data.url} />

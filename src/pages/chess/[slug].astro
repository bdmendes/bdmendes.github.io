---
import { type CollectionEntry, getCollection } from "astro:content";
import {
  createChessDescription,
  createChessSlug,
  extractDate,
  gameColor,
  sortedByDate,
} from "../../lib/util";
import ChessGameLayout from "@layouts/ChessGameLayout.astro";
import type { NavLink } from "@layouts/PostLayout.astro";

export async function getStaticPaths() {
  const games = sortedByDate(await getCollection("chess"));
  const link = (g?: CollectionEntry<"chess">) =>
    g && {
      title: (g.data.white ? g.data.white : g.data.black) ?? "",
      url: "/chess/" + createChessSlug(g),
      status: gameColor(g) as "green" | "grey" | "red",
    };
  return games.map((game, i) => ({
    params: { slug: createChessSlug(game) },
    props: { game, prev: link(games[i - 1]), next: link(games[i + 1]) },
  }));
}

interface Props {
  game: CollectionEntry<"chess">;
  prev?: NavLink;
  next?: NavLink;
}

const { game, prev, next } = Astro.props;
---

<ChessGameLayout
  date={extractDate(game.id)}
  white={game.data.white}
  black={game.data.black}
  result={game.data.result}
  tournament={game.data.tournament}
  pgn={game.body!}
  whiteElo={game.data.whiteElo}
  blackElo={game.data.blackElo}
  round={game.data.round}
  board={game.data.board}
  description={createChessDescription(game)}
  fen={game.data.fen}
  prev={prev}
  next={next}
/>

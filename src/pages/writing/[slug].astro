---
import { type CollectionEntry, getCollection } from "astro:content";
import PostLayout from "@layouts/PostLayout.astro";
import { createSlug, extractDate, extractDescription, validateBody } from "../../lib/util";
import { render } from "astro:content";

export async function getStaticPaths() {
  const textEntries = await getCollection("writing");
  return textEntries.map((entry) => ({
    params: { slug: createSlug(entry.data.title) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"writing">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

validateBody(entry.data.title, entry.body!);
---

<PostLayout
  title={entry.data.title}
  description={extractDescription(entry.body!)}
  date={extractDate(entry.id)}
  badge={"writing"}
  sideBarActiveItemID="writing"
>
  <Content />
</PostLayout>

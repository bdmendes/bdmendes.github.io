---
import { type CollectionEntry, getCollection } from "astro:content";
import PostLayout from "@layouts/PostLayout.astro";
import { createSlug, extractDate, extractDescription, sortedByDate, validateBody } from "../../lib/util";
import { render } from "astro:content";

export async function getStaticPaths() {
  const textEntries = sortedByDate(await getCollection("writing"));
  const link = (e?: CollectionEntry<"writing">) =>
    e && { title: e.data.title, url: "/writing/" + createSlug(e.data.title) };
  return textEntries.map((entry, i) => ({
    params: { slug: createSlug(entry.data.title) },
    props: { entry, prev: link(textEntries[i + 1]), next: link(textEntries[i - 1]) },
  }));
}

interface Props {
  entry: CollectionEntry<"writing">;
  prev?: { title: string; url: string };
  next?: { title: string; url: string };
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

validateBody(entry.data.title, entry.body!);
---

<PostLayout
  title={entry.data.title}
  description={extractDescription(entry.body!)}
  date={extractDate(entry.id)}
  badge={"writing"}
  sideBarActiveItemID="writing"
  prev={prev}
  next={next}
>
  <Content />
</PostLayout>

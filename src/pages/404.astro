---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout title="404: Not Found" currentPage={1}>
  <div class="text-center">
    <Icon name="broccoli" size="64" class="mx-auto my-6 text-muted" aria-hidden="true" />
    <h1 class="text-3xl font-bold mb-3">There's nothing here</h1>
    <h3 class="max-w-md mx-auto px-3 text-muted">
      If you came from a search engine, it is likely I moved this content to a
      different location. Please look around.
    </h3>
    <a
      href="/"
      class="inline-block mt-4 underline decoration-primary decoration-1 underline-offset-3 transition-colors hover:text-primary"
    >
      Back to home
    </a>
  </div>
</BaseLayout>

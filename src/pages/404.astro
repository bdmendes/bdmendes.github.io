---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="404: Not Found" currentPage={1}>
  <div class="text-center">
    <h1 class="text-6xl font-bold my-6">🥦</h1>
    <h1 class="text-3xl font-bold mb-3">There's nothing here</h1>
    <h3 class="max-w-md mx-auto px-3">
      If you came from a search engine, it is likely I moved this content to a
      different location. Please look around.
    </h3>
  </div>
</BaseLayout>

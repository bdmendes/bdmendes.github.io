---
import BaseLayout from "./BaseLayout.astro";
import PrevNext, { type NavLink } from "@components/PrevNext.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props {
  title: string;
  customHeader?: string[];
  description: string;
  date: Date;
  badge: string;
  tags?: string[];
  disabledTags?: string[];
  createYearBadge?: boolean;
  tagEndpoint?: string;
  shrink?: boolean;
  sideBarActiveItemID: string;
  prev?: NavLink;
  next?: NavLink;
}

const {
  title,
  customHeader,
  description,
  date,
  badge,
  tags = [],
  disabledTags = [],
  createYearBadge = true,
  tagEndpoint = "tag",
  shrink = true,
  sideBarActiveItemID,
  prev,
  next,
} = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(date).format("ll");
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  currentPage={1}
  shrink={shrink}
  sideBarActiveItemID={sideBarActiveItemID}
  index={true}
>
  <div class="mx-auto prose prose-img:mx-auto max-w-[inherit]">
    {
      customHeader ? (
        <div>
          <h1 hidden data-pagefind-meta="title" class="pagefind-exclude">{title}</h1>
          <div class="flex w-full justify-between gap-4 mt-0 mb-2 items-center pagefind-exclude">
            {Object.entries(customHeader).map(([_, h], idx) => (
              <div
                class={`text-lg md:text-2xl grow-0 font-bold ${idx == 2 ? "text-right" : ""} ${idx == 1 ? "shrink-0" : ""}`}
              >
                {h}
              </div>
            ))}
          </div>
        </div>
      ) : (
        <h1 data-pagefind-meta="title" class="pagefind-exclude mb-2 text-3xl md:text-4xl max-w-min min-w-full font-bold text-balance">{title}</h1>
      )
    }
    <div aria-hidden="true" class="flex flex-wrap items-center gap-x-3 gap-y-2 mt-3 mb-6 max-w-min min-w-full">
      {date && <time datetime={dayjs(date).format("YYYY-MM-DD")} data-pagefind-meta={`date:${displayDate}`} class="pagefind-exclude text-subtle">{displayDate}</time>}
      <div class="flex gap-2 flex-wrap">
        <a
          data-pagefind-filter="category"
          data-pagefind-meta="category"
          href={`/${badge}`}
          class="badge badge-outline no-underline pagefind-exclude"
        >
          {badge}
        </a>
        {
          tags?.map((tag) => (
            <a
              href={`/${badge}/${tagEndpoint}/${tag}`}
              class="badge badge-outline no-underline"
            >
              {tag}
            </a>
          ))
        }
        {
          disabledTags?.map((tag) => (
            <span class="badge badge-ghost pagefind-exclude">{tag}</span>
          ))
        }
        {
          createYearBadge && (
            <a
              href={`/${badge}/year/${date.getFullYear().toString()}`}
              class="badge badge-outline no-underline pagefind-exclude"
            >
              {date.getFullYear().toString()}
            </a>
          )
        }
      </div>
    </div>
    <article><slot /></article>
    <PrevNext {prev} {next} label="Previous and next" class="not-prose max-w-min min-w-full pagefind-exclude" />
  </div>
</BaseLayout>

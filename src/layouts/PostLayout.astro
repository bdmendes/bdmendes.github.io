---
import BaseLayout from "./BaseLayout.astro";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props {
  title: string;
  customHeader?: string[];
  description: string;
  date: Date;
  badge: string;
  tags?: string[];
  disabledTags?: string[];
  createYearBadge?: boolean;
  tagEndpoint?: string;
  shrink?: boolean;
  sideBarActiveItemID: string;
  prev?: NavLink;
  next?: NavLink;
}

export type NavLink = { title: string; url: string; status?: "green" | "grey" | "red" };

const {
  title,
  customHeader,
  description,
  date,
  badge,
  tags = [],
  disabledTags = [],
  createYearBadge = true,
  tagEndpoint = "tag",
  shrink = true,
  sideBarActiveItemID,
  prev,
  next,
} = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(date).format("ll");
const statusColor = { green: "bg-green-400", grey: "bg-gray-400", red: "bg-red-400" };
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  currentPage={1}
  shrink={shrink}
  sideBarActiveItemID={sideBarActiveItemID}
  index={true}
>
  <div class="mx-auto prose prose-img:mx-auto max-w-[inherit]">
    {
      customHeader ? (
        <div>
          <h1 hidden>{title}</h1>
          <div class="flex w-full justify-between gap-4 mt-0 mb-2 items-center pagefind-exclude">
            {Object.entries(customHeader).map(([_, h], idx) => (
              <div
                class={`text-lg md:text-2xl grow-0 font-bold ${idx == 2 ? "text-right" : ""} ${idx == 1 ? "shrink-0" : ""}`}
              >
                {h}
              </div>
            ))}
          </div>
        </div>
      ) : (
        <h1 class="mb-2 text-3xl md:text-4xl max-w-min min-w-full font-bold text-balance">{title}</h1>
      )
    }
    <div aria-hidden="true" class="flex flex-wrap items-center gap-x-3 gap-y-2 mt-3 mb-6">
      {date && <time datetime={dayjs(date).format("YYYY-MM-DD")} class="pagefind-exclude text-subtle">{displayDate}</time>}
      <div class="flex gap-2 flex-wrap">
        <a
          data-pagefind-filter="category"
          href={`/${badge}`}
          class="badge badge-outline no-underline pagefind-exclude"
        >
          {badge}
        </a>
        {
          tags?.map((tag) => (
            <a
              href={`/${badge}/${tagEndpoint}/${tag}`}
              class="badge badge-outline no-underline"
            >
              {tag}
            </a>
          ))
        }
        {
          disabledTags?.map((tag) => (
            <span class="badge badge-ghost pagefind-exclude">{tag}</span>
          ))
        }
        {
          createYearBadge && (
            <a
              href={`/${badge}/year/${date.getFullYear().toString()}`}
              class="badge badge-outline no-underline pagefind-exclude"
            >
              {date.getFullYear().toString()}
            </a>
          )
        }
      </div>
    </div>
    <article><slot /></article>
    {
      (prev || next) && (
        <nav class="not-prose grid grid-cols-2 gap-4 max-w-min min-w-full my-7 pagefind-exclude no-print" aria-label="Previous and next">
          {prev ? (
            <a href={prev.url} rel="prev" class="group justify-self-start" data-fit>
              <span class="inline-flex items-center gap-1 align-top text-sm text-subtle mb-1" data-fit-part><Icon name="mdi:arrow-left" size="14" />Previous</span>
              <span class="block font-bold leading-snug text-balance text-muted transition-colors group-hover:text-primary"><span data-fit-part>{prev.title}{prev.status && <span aria-hidden="true" class={`status ml-2 align-middle ${statusColor[prev.status]}`} />}</span></span>
            </a>
          ) : <span />}
          {next && (
            <a href={next.url} rel="next" class="group justify-self-end text-right" data-fit>
              <span class="inline-flex items-center gap-1 align-top text-sm text-subtle mb-1" data-fit-part>Next<Icon name="mdi:arrow-right" size="14" /></span>
              <span class="block font-bold leading-snug text-balance text-muted transition-colors group-hover:text-primary"><span data-fit-part>{next.status && <span aria-hidden="true" class={`status mr-2 align-middle ${statusColor[next.status]}`} />}{next.title}</span></span>
            </a>
          )}
        </nav>
      )
    }
  </div>
</BaseLayout>

<script>
  // Size each prev/next link to its widest line (label or balanced title), so
  // the clickable area is the text's box rather than the whole grid column.
  const fit = () =>
    document.querySelectorAll<HTMLElement>("[data-fit]").forEach((link) => {
      link.style.width = "";
      const parts = [...link.querySelectorAll<HTMLElement>("[data-fit-part]")];
      const width = Math.max(...parts.map((p) => p.getBoundingClientRect().width));
      link.style.width = Math.ceil(width) + 1 + "px";
    });
  fit();
  document.fonts.ready.then(fit);
  addEventListener("resize", fit);
</script>

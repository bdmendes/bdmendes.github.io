---
import "../styles/global.css";

import SideBar from "@components/SideBar.astro";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-icon/components";

import { METADATA, TRANSITION_API } from "../config";

export interface Props {
  title: string;
  description?: string;
  sideBarActiveItemID?: string;
  ogType?: string;
  currentPage: number;
  shrink?: boolean;
  index?: boolean;
}

const {
  title,
  description = METADATA.description,
  sideBarActiveItemID,
  ogType,
  currentPage,
  shrink = false,
  index = false,
} = Astro.props;

const completeTitle =
  title +
  " | " +
  (currentPage > 1 ? "Page " + currentPage + " | " : "") +
  METADATA.title;
---

<!doctype html>
<html lang="en" data-theme="halloween">
  <head>
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,interactive-widget=resizes-content"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicons/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicons/favicon-16x16.png"
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{completeTitle}</title>
    <meta name="title" content={completeTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={completeTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="" />

    <!-- Twitter -->
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={completeTitle} />
    <meta property="twitter:description" content={description} />
    <meta name="twitter:image" content="false" />

    {TRANSITION_API && <ClientRouter />}
  </head>

  <body class="flex justify-center">
    <div class="drawer md:drawer-open w-4xl divide-x divide-base-300">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <SideBar sideBarActiveItemID={sideBarActiveItemID} />
      <div class="drawer-content">
        <div
          class="no-print md:hidden top-0 z-30 flex w-full justify-center transition-all duration-100 text-base-content"
        >
          <div class="navbar">
            <label for="my-drawer" class="btn btn-square btn-ghost">
              <Icon name="mdi:menu" size="24" />
            </label>
            <a
              href="/"
              class="btn btn-square btn-ghost"
              aria-label="Home"
              title="Home"
            >
            <img
               src="/assets/about-me/cv-profile-drawing.png"
               class="w-8 h-8 rounded-full saturate-0 brightness-80"
            />
            </a>
          </div>
        </div>

        <main
          class={"p-5 md:p-8 mx-auto w-full flex justify-center" +
            (index ? "" : " pagefind-exclude")}
        >
          <div class={shrink ? "" : "w-full"}>
            <slot />
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

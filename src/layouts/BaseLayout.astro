---
import "../styles/global.css";
import serifFont from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url";

import NavBar from "@components/NavBar.astro";

import { METADATA } from "../config";

export interface Props {
  title: string;
  description?: string;
  navBarActiveItemID?: string;
  ogType?: string;
  currentPage: number;
  shrink?: boolean;
  index?: boolean;
}

const {
  title,
  description = METADATA.description,
  navBarActiveItemID,
  ogType,
  currentPage,
  shrink = false,
  index = false,
} = Astro.props;

const completeTitle =
  title +
  " | " +
  (currentPage > 1 ? "Page " + currentPage + " | " : "") +
  METADATA.title;
---

<!doctype html>
<html lang="en" data-theme="halloween" class="scroll-pt-20 md:scroll-pt-0">
  <head>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={METADATA.title} href="/rss.xml" />

    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#161412" />
    <script is:inline>
      // A choice made with the toggle wins; otherwise, or if storage is blocked, follow the system.
      let stored = null;
      try {
        stored = localStorage.getItem("theme");
      } catch {}
      if (stored ? stored === "paper" : matchMedia("(prefers-color-scheme: light)").matches) {
        document.documentElement.dataset.theme = "paper";
        document.querySelector('meta[name="theme-color"]').content = "#f4efe8";
      }
    </script>
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicons/apple-touch-icon.png?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicons/favicon-32x32.png?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicons/favicon-16x16.png?v=2"
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{completeTitle}</title>
    <meta name="title" content={completeTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={completeTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="" />

    <!-- Twitter -->
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={completeTitle} />
    <meta property="twitter:description" content={description} />
    <meta name="twitter:image" content="false" />
  </head>

  <body class="glow min-h-dvh">
    <div class="mx-auto w-full max-w-4xl flex flex-col md:flex-row md:divide-x divide-base-300">
      <NavBar navBarActiveItemID={navBarActiveItemID} />
      <main
        class={"px-5 pt-7 pb-11 md:px-7 mx-auto w-full min-w-0 flex justify-center" +
          (index ? "" : " pagefind-exclude")}
      >
        <div class={`flex flex-col gap-3 ${shrink ? "min-w-[min(15rem,100%)]" : "min-w-0 w-full"}`}>
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>

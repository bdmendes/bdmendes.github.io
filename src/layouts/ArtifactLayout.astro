---
import { METADATA } from "src/config";
import "../styles/slides.css";

export interface Props {
  title: string;
  body: string;
  description: string;
  url?: string;
}

const { title, body, description, url } = Astro.props;
---

<html>
  <head>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicons/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicons/favicon-16x16.png"
    />
    <meta charset="utf-8" />
    <title>{`${title} | ${METADATA.title}`}</title>
  </head>

  <body style={url ? "margin: 0; overflow: hidden" : undefined}>
    <div hidden>
        <h1>{title}</h1>
        <div data-pagefind-filter="category" class="pagefind-exclude">
            artifacts
        </div>
        <p>{description}</p>
    </div>
    {
      url ? (
        <iframe
          src={url}
          title={title}
          style="display: block; width: 100vw; height: 100dvh; border: 0"
        ></iframe>
      ) : (
        <>
          <textarea id="source">{body}</textarea>
          <script is:inline src="/lib/remark.js" type="text/javascript"></script>
          <script is:inline type="text/javascript">
            remark.create({
              navigation: { scroll: false },
              highlightStyle: "sunburst",
            });
          </script>
        </>
      )
    }
  </body>
</html>

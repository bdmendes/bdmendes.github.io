---
export interface Props {
  title: string;
  title2?: string;
  img?: ImageMetadata;
  description?: string;
  url?: string;
  badge?: string;
  tags?: string[];
  disabledTags?: string[];
  forceVertical?: boolean;
  status?: "red" | "grey" | "green" | undefined;
}

const {
  title,
  title2,
  img,
  description,
  url,
  badge,
  tags = [],
  disabledTags = [],
  forceVertical = false,
  status,
} = Astro.props;
import { Image } from "astro:assets";
---

<div class="flex flex-col">
  <div class=`rounded-box grow group mb-1 transition-colors hover:bg-base-200`>
    <a class="w-full" href={url}>
      <div
        class={`w-full hero-content p-3 flex flex-col items-start ${forceVertical ? "gap-2.5" : "sm:flex-row"}`}
      >
        <slot />
        {
          img && (
            <Image
              src={img}
              format="webp"
              alt={title}
              class="max-h-32 rounded object-cover sm:aspect-square sm:max-w-32"
            />
          )
        }
        <div class="grow w-full">
          <div class="flex gap-3 items-center">
            {status == "green" && (<div aria-label="status" class="status bg-green-400"></div>)}
            {status == "grey" && (<div aria-label="status" class="status bg-gray-400"></div>)}
            {status == "red" && (<div aria-label="status" class="status bg-red-400"></div>)}
            <div class="transition-colors group-hover:text-primary">
              <h1 class="text-xl font-bold mr-2">
              {title}
              </h1>
              {title2 && <h1 class="text-xl font-bold mr-2">{title2}</h1>}
            </div>
          </div>
          {description && <p class="py-1 text-muted">{description}</p>}
          {
            (tags.length > 0 || badge || disabledTags.length > 0) && (
              <div class="card-actions mt-3">
                {disabledTags.toReversed().map((tag) => (
                  <span class="badge badge-ghost">{tag}</span>
                ))}
                {tags.toReversed().map((tag) => (
                  <span class="badge badge-ghost">{tag}</span>
                ))}
                {badge && <span class="badge badge-ghost">{badge}</span>}
              </div>
            )
          }
        </div>
      </div>
    </a>
  </div>
</div>

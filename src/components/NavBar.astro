---
import { ROUTES, SOCIALS } from "src/config";
import Icon from "node_modules/astro-icon/components/Icon.astro";
import { Image } from "astro:assets";
import profile from "src/assets/cv-profile-drawing.png";

export interface Props {
  navBarActiveItemID?: string;
}

const { navBarActiveItemID } = Astro.props;
const cleanId = navBarActiveItemID?.replace(/\d+/g, "");
---

<aside
  class="glow no-print sticky top-0 z-30 shrink-0 md:h-dvh md:w-44 flex md:flex-col items-center md:items-stretch gap-3 md:gap-6 ps-4 md:px-0 md:pt-5 border-b border-base-300 md:border-b-0 text-base-content"
>
  <a href="/" class="shrink-0 -mt-0.5 md:mt-0 md:self-center aspect-square h-8 md:h-24">
    <Image
      src={profile}
      width={192}
      height={192}
      format="webp"
      loading="eager"
      alt="Bruno Mendes"
      class="object-contain w-full h-full rounded-full saturate-0 sepia-[.4] brightness-80 paper:brightness-100 paper:mix-blend-multiply paper:sepia-0"
    />
  </a>
  <div class="flex md:flex-col min-w-0 md:min-h-0 py-2.5 md:py-0 overflow-x-auto md:overflow-y-auto scrollbar-none pagefind-exclude md:items-center md:px-7 snap-x md:snap-y snap-mandatory scroll-fade">
    <ul class="menu menu-horizontal md:menu-vertical flex-nowrap md:shrink-0 p-0 gap-0.5 md:gap-1 pe-3 md:pe-0 md:pb-5 md:w-full [--menu-active-bg:var(--color-base-200)] [--menu-active-fg:var(--color-base-content)]">
      {
        Object.entries(ROUTES).map(([key, value]) => (
          <li>
            <a
              class={`px-2.5 py-2 md:py-2.5 text-sm md:text-base whitespace-nowrap justify-center ${cleanId == key ? "menu-active gloss-selected snap-center" : "text-muted transition-[color,background-color,box-shadow] hover:text-primary hover:bg-base-200 hover:gloss"}`}
              aria-current={cleanId == key ? "page" : undefined}
              id={key}
              href={key == "home" ? "/" : "/" + key}
            >
              {value}
            </a>
          </li>
        ))
      }
      <li class="ms-1 md:ms-0">
        <button
          id="theme-toggle"
          type="button"
          class="px-1.5 md:py-2.5 justify-center md:w-full text-muted transition-[color,background-color,box-shadow] hover:text-primary hover:bg-base-200 hover:gloss"
        >
          <Icon name="mdi:white-balance-sunny" size="24" class="paper:hidden" />
          <Icon name="mdi:weather-night" size="24" class="hidden paper:block" />
        </button>
      </li>
      {
        Object.entries(SOCIALS).map(([key, value]) => (
          <li>
            <a
              href={value.url}
              class="px-1.5 md:py-2.5 justify-center md:w-full text-muted transition-[color,background-color,box-shadow] hover:text-primary hover:bg-base-200 hover:gloss"
              target="_blank"
              aria-label={key}
              title={key}
            >
              <Icon name={value.icon} size="24" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<script>
  const button = document.querySelector<HTMLButtonElement>("#theme-toggle")!;
  const updateLabel = () => {
    const label = document.documentElement.dataset.theme === "paper"
      ? "Switch to dark theme"
      : "Switch to light theme";
    button.setAttribute("aria-label", label);
    button.title = label;
  };

  updateLabel();
  button.addEventListener("click", () => {
    const root = document.documentElement;
    const theme = root.dataset.theme === "paper" ? "halloween" : "paper";
    root.dataset.theme = theme;
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content =
      getComputedStyle(root).getPropertyValue("--color-base-100");
    try {
      localStorage.setItem("theme", theme);
    } catch {}
    updateLabel();
  });
</script>

<script is:inline>
  // Snapping places the section list on the current section during the first layout,
  // before anything is painted: the mobile bar sideways, or a navbar too short for its
  // screen vertically. Its scrollbar stays hidden until then, as that first snap would
  // reveal it; the first interaction releases snapping and shows the desktop scrollbar.
  (() => {
    const nav = document.querySelector("aside .scroll-fade");
    const release = () => nav.classList.remove("snap-x", "md:snap-y", "snap-mandatory");
    for (const e of ["pointerdown", "wheel", "focusin"]) nav?.addEventListener(e, release, { once: true });
  })();
</script>

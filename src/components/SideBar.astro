---
import { ROUTES, SOCIALS } from "src/config";
import Icon from "node_modules/astro-icon/components/Icon.astro";
import { Image } from "astro:assets";
import profile from "src/assets/cv-profile-drawing.png";

export interface Props {
  sideBarActiveItemID?: string;
}

const { sideBarActiveItemID } = Astro.props;
const cleanId = sideBarActiveItemID?.replace(/\d+/g, "");
---

<div class="drawer-side z-40 no-print">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside
    class="glass-sidebar min-h-dvh w-32 md:w-44 bg-base-100 md:bg-transparent text-base-content flex flex-col gap-6 py-5"
  >
    <a href="/" class="self-center max-h-[50svh] aspect-square h-20 md:h-24">
      <Image
        src={profile}
        width={192}
        height={192}
        format="webp"
        loading="eager"
        alt="Bruno Mendes"
        class="object-contain w-full h-full rounded-full saturate-0 sepia-[.4] brightness-80"
      />
    </a>
    <div class="flex flex-col pagefind-exclude items-center px-3 md:px-7">
      <ul class="menu p-0 overflow-y-auto gap-1 w-full [--menu-active-bg:var(--color-base-200)] [--menu-active-fg:var(--color-base-content)]">
        {
          Object.entries(ROUTES).map(([key, value]) => (
            <li>
              <a
                class={`py-2.5 text-base justify-center ${cleanId == key ? "menu-active" : "text-muted transition-colors hover:text-primary hover:bg-base-200"}`}
                aria-current={cleanId == key ? "page" : undefined}
                id={key}
                href={key == "home" ? "/" : "/" + key}
              >
                {value}
              </a>
            </li>
          ))
        }
        {
          Object.entries(SOCIALS).map(([key, value]) => (
            <li>
              <a
                href={value.url}
                class="py-2.5 justify-center self-center w-full text-muted transition-colors hover:text-primary hover:bg-base-200"
                target="_blank"
                aria-label={key}
                title={key}
              >
                <Icon name={value.icon} size="24" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </aside>
</div>

---
import { ROUTES, SOCIALS } from "src/config";
import Icon from "node_modules/astro-icon/components/Icon.astro";
import { Image } from "astro:assets";
import profile from "src/assets/cv-profile-drawing.png";

export interface Props {
  sideBarActiveItemID?: string;
}

const { sideBarActiveItemID } = Astro.props;
const cleanId = sideBarActiveItemID?.replace(/\d+/g, "");
---

<aside
  class="glow md:bg-none md:bg-transparent no-print sticky top-0 z-30 shrink-0 md:h-dvh md:w-44 md:overflow-y-auto flex md:flex-col items-center md:items-stretch gap-3 md:gap-6 ps-3 md:px-0 md:pt-5 md:pb-8 border-b border-base-300 md:border-b-0 text-base-content"
>
  <a href="/" class="shrink-0 -mt-0.5 md:mt-0 md:self-center aspect-square h-8 md:h-24">
    <Image
      src={profile}
      width={192}
      height={192}
      format="webp"
      loading="eager"
      alt="Bruno Mendes"
      class="object-contain w-full h-full rounded-full saturate-0 sepia-[.4] brightness-80"
    />
  </a>
  <div class="flex md:flex-col min-w-0 py-3 md:py-0 overflow-x-auto md:overflow-visible pagefind-exclude md:items-center md:px-7 opacity-0 data-ready:opacity-100 md:opacity-100 scroll-fade md:mask-none md:animate-none">
    <ul class="menu menu-horizontal md:menu-vertical flex-nowrap p-0 gap-0.5 md:gap-1 pe-3 md:pe-0 md:w-full [--menu-active-bg:var(--color-base-200)] [--menu-active-fg:var(--color-base-content)]">
      {
        Object.entries(ROUTES).map(([key, value]) => (
          <li>
            <a
              class={`px-3 py-2 md:py-2.5 text-sm md:text-base whitespace-nowrap justify-center ${cleanId == key ? "menu-active gloss-selected" : "text-muted transition-[color,background-color,box-shadow] hover:text-primary hover:bg-base-200 hover:gloss"}`}
              aria-current={cleanId == key ? "page" : undefined}
              id={key}
              href={key == "home" ? "/" : "/" + key}
            >
              {value}
            </a>
          </li>
        ))
      }
      {
        Object.entries(SOCIALS).map(([key, value], i) => (
          <li class={i == 0 ? "ms-1 md:ms-0" : ""}>
            <a
              href={value.url}
              class="p-1.5 md:py-2.5 justify-center md:w-full text-muted transition-[color,background-color,box-shadow] hover:text-primary hover:bg-base-200 hover:gloss"
              target="_blank"
              aria-label={key}
              title={key}
            >
              <Icon name={value.icon} size="24" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<noscript><style>aside .scroll-fade { opacity: 1 }</style></noscript>

<script is:inline>
  // Keep the mobile bar where it was on the previous page, then slide only if the
  // current section is hidden. The bar stays invisible until placed, so browsers
  // that paint before this runs never show it jump.
  (() => {
    const nav = document.querySelector("aside .scroll-fade");
    if (!nav) return;
    const current = nav.querySelector("[aria-current=page]");
    let saved = null;
    try { saved = sessionStorage.getItem("nav-scroll"); } catch {}
    addEventListener("pagehide", () => { try { sessionStorage.setItem("nav-scroll", nav.scrollLeft); } catch {} });
    if (current) {
      const n = nav.getBoundingClientRect(), c = current.getBoundingClientRect(), fade = 48;
      if (saved === null) {
        nav.scrollLeft += c.left - n.left - (nav.clientWidth - current.offsetWidth) / 2;
      } else {
        nav.scrollLeft = +saved;
        document.fonts.ready.then(() => {
          const { left, right } = current.getBoundingClientRect();
          const delta = Math.min(0, left - n.left - fade) || Math.max(0, right - n.right + fade);
          if (delta) nav.scrollBy({ left: delta, behavior: "smooth" });
        });
      }
    }
    nav.dataset.ready = "";
  })();
</script>

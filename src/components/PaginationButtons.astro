---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";

export interface Props {
  page: Page;
  path: string;
}

const { page, path } = Astro.props;
const href = (p: number) => path + (p == 1 ? "" : "/" + p);
const prev = page.currentPage > 1 ? page.currentPage - 1 : undefined;
const next = page.currentPage < page.lastPage ? page.currentPage + 1 : undefined;
---

{
  (prev || next) && (
    <nav class="grid grid-cols-2 gap-4 px-3 my-4" aria-label="Pagination">
      {prev ? (
        <a href={href(prev)} class="group justify-self-start">
          <span class="flex items-center gap-1 text-sm text-subtle mb-1">
            <Icon name="mdi:arrow-left" size="14" />
            Previous
          </span>
          <span class="block font-bold text-muted transition-colors group-hover:text-primary">
            Page {prev}
          </span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={href(next)} class="group justify-self-end text-right">
          <span class="flex items-center justify-end gap-1 text-sm text-subtle mb-1">
            Next
            <Icon name="mdi:arrow-right" size="14" />
          </span>
          <span class="block font-bold text-muted transition-colors group-hover:text-primary">
            Page {next}
          </span>
        </a>
      )}
    </nav>
  )
}

---
import type { Page } from "astro";
import PrevNext from "./PrevNext.astro";

export interface Props {
  page: Page;
  path: string;
}

const { page, path } = Astro.props;
const link = (p: number) => ({ title: "Page " + p, url: path + (p == 1 ? "" : "/" + p) });
---

<PrevNext
  prev={page.currentPage > 1 ? link(page.currentPage - 1) : undefined}
  next={page.currentPage < page.lastPage ? link(page.currentPage + 1) : undefined}
  label="Pagination"
  class="px-3"
/>

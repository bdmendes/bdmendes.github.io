---
import { Icon } from "astro-icon/components";
import "../styles/search.css";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

export interface Props {
  path?: string;
  title: string;
  selector?: string;
  filters?: [string, string, number?][];
  search?: boolean;
}

const { path, title, selector, filters, search = false } = Astro.props;
const filterModalId = title.replace(/[^a-zA-Z]+/g, "") + "filter";
const searchModalId = title.replace(/[^a-zA-Z]+/g, "") + "search";
const iconSize = 26;
---

<div class="flex items-center justify-between gap-3 flex-wrap w-full mb-4">
  <a href={path} class={`text-2xl md:text-3xl font-bold ${path ? "transition-colors hover:text-primary" : ""}`}>{title}</a>
  <div class="flex gap-2 items-center mt-0.5">
    <slot />
    {
      selector && (
        <div class="flex gap-2 items-center">
          <span class="badge badge-ghost leading-4 pb-0.5 text-center">{selector}</span>
          <a href={path} class="text-muted hover:text-primary transition-colors" aria-label="Clear filter">
            <Icon name="mdi:filter-off" size={iconSize} />
          </a>
        </div>
      )
    }

    {
      filters && (
        <div class="flex items-center">
          <button
            class="cursor-pointer text-muted hover:text-primary transition-colors"
            aria-label="Filter"
            onclick={filterModalId + ".showModal()"}
          >
            <Icon name="mdi:filter" size={iconSize} />
          </button>
          <dialog id={filterModalId} class="modal modal-top">
            <ol class="modal-box w-fit min-w-32 flex flex-col gap-2 items-center max-h-[90svh] md:max-h-[80svh] mx-auto">
              {filters.map((f) => (
                <li class="text-center w-full">
                  <a class="btn px-5 w-full sm:text-nowrap justify-between gap-3 transition-colors hover:text-primary" href={f[1]}>
                    {f[0]}
                    {f[2] != null && <span class="text-xs text-muted">{f[2]}</span>}
                  </a>
                </li>
              ))}
            </ol>
            <form method="dialog" class="modal-backdrop">
              <button>close</button>
            </form>
          </dialog>
        </div>
      )
    }

    {
      search && (
        <div class="flex items-center">
          <button
            class="cursor-pointer text-muted hover:text-primary transition-colors"
            aria-label="Search"
            data-large-title-search
            onclick={
              searchModalId +
              ".showModal();" +
              'filterCategory("' + (path ? path.replace("/", "") : "") + '");'
            }
          >
            <Icon name="mdi:magnify" size={iconSize} />
          </button>
          <dialog id={searchModalId} class="modal modal-top">
            <div class="modal-box max-w-lg max-h-[90svh] md:max-h-[80svh] mx-auto pagefind-search" data-pf-theme="dark">
                <PagefindConfig />
                <div class="hidden">
                  <pagefind-filter-pane show-empty="true" expanded="true" ></pagefind-filter-pane>
                </div>
                <pagefind-input
                  placeholder={"Search " + (path ? path.replace("/", "") : "everything")}>
                </pagefind-input>
                <pagefind-summary class="mt-5! mb-2.5!"></pagefind-summary>
                <pagefind-results hide-sub-results="true"></pagefind-results>
            </div>
            <form method="dialog" class="modal-backdrop">
              <button>close</button>
            </form>
          </dialog>
        </div>
      )
    }
  </div>
</div>

<script is:inline>
  function filterCategory(category) {
    setTimeout(() => {
      const boxes = [...document.querySelectorAll('[id^="pf-filter-category-"]')];
      if (!boxes.length) {
        filterCategory(category);
        return;
      }
      boxes.forEach((box) => {
        const wanted = !!category && box.id.startsWith("pf-filter-category-" + category);
        if (box.checked !== wanted) box.click();
      });
    }, 100);
  }
</script>

<script>
  document.addEventListener("keydown", (event) => {
    if ((!event.ctrlKey && !event.metaKey) || event.key.toLowerCase() !== "k") {
      return;
    }

    const searchButton = document.querySelector<HTMLButtonElement>("[data-large-title-search]");
    if (!searchButton) {
      return;
    }

    event.preventDefault();

    const searchDialog = searchButton.parentElement?.querySelector("dialog");
    if (!searchDialog?.open) {
      searchButton.click();
    }
  });
</script>

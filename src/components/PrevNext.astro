---
import { Icon } from "astro-icon/components";

export type NavLink = { title: string; url: string; status?: "green" | "grey" | "red" };

export interface Props {
  prev?: NavLink;
  next?: NavLink;
  label: string;
  class?: string;
}

const { prev, next, label, class: className = "" } = Astro.props;
const statusColor = { green: "bg-green-400", grey: "bg-gray-400", red: "bg-red-400" };
---

{
  (prev || next) && (
    <nav class={`grid grid-cols-2 gap-4 py-3 no-print ${className}`} aria-label={label}>
      {prev ? (
        <a href={prev.url} rel="prev" class="group justify-self-start" data-fit>
          <span class="flex w-fit items-center gap-1 text-sm text-subtle mb-1.5" data-fit-part><Icon name="mdi:arrow-left" size="14" />Previous</span>
          <span class="block font-bold leading-snug text-balance text-muted transition-colors group-hover:text-primary"><span data-fit-part>{prev.title}{prev.status && <span aria-hidden="true" class={`status ml-2 align-middle ${statusColor[prev.status]}`} />}</span></span>
        </a>
      ) : <span />}
      {next && (
        <a href={next.url} rel="next" class="group justify-self-end text-right" data-fit>
          <span class="flex w-fit ml-auto items-center gap-1 text-sm text-subtle mb-1.5" data-fit-part>Next<Icon name="mdi:arrow-right" size="14" /></span>
          <span class="block font-bold leading-snug text-balance text-muted transition-colors group-hover:text-primary"><span data-fit-part>{next.status && <span aria-hidden="true" class={`status mr-2 align-middle ${statusColor[next.status]}`} />}{next.title}</span></span>
        </a>
      )}
    </nav>
  )
}

<script>
  // Size each prev/next link to its widest line (label or balanced title), so
  // the clickable area is the text's box rather than the whole grid column.
  const fit = () =>
    document.querySelectorAll<HTMLElement>("[data-fit]").forEach((link) => {
      link.style.width = "";
      const parts = [...link.querySelectorAll<HTMLElement>("[data-fit-part]")];
      const width = Math.max(...parts.map((p) => p.getBoundingClientRect().width));
      link.style.width = Math.ceil(width) + 1 + "px";
    });
  fit();
  document.fonts.ready.then(fit);
  addEventListener("resize", fit);
</script>

---
export interface Props {
  title: string;
  from: string;
  to?: string;
  location: string;
  grade?: string;
}

const { title, from, to, location, grade } = Astro.props;
---

<div class="flex mb-4">
  <div class="entry_time pr-5">
    <span class="w-4 h-4 bg-neutral block mt-0.75"></span>
    <div class="w-4 h-full flex justify-center">
        <span class="entry_line bg-neutral block h-full w-1">
    </div>
  </div>
  <div class="entry_data bd-grid mb-1">
    <div class="font-semibold mb-1 flex items-baseline flex-wrap gap-2">
      <span>{title} @ {location}</span>
      <span class="badge badge-dash font-normal text-sm"
        >{from} {to ? (to != from ? `- ${to}` : "") : "- Present"}</span
      >
      {
        grade && (
          <span class="badge badge-dash font-normal text-sm">{grade}</span>
        )
      }
    </div>
    <p class="mt-2 text-justify">
      <slot />
    </p>
  </div>
</div>

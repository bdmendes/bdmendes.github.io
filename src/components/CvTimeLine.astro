---
export interface Props {
  title: string;
  from: string;
  to?: string;
  location: string;
  grade?: string;
}

const { title, from, to, location, grade } = Astro.props;
---

<div class="flex mb-4">
  <div class="entry_time pr-3">
    <span class="w-4 h-4 bg-base-300 block mt-1.25 rounded-md"></span>
    <div class="w-4 h-full flex justify-center">
      <span class="entry_line bg-base-300 block h-full w-1" />
    </div>
  </div>
  <div class="entry_data bd-grid mb-1">
    <span class="font-semibold mb-1 leading-6.5">
      <span>{title} @ {location}</span>&ensp;<span class="badge badge-ghost font-normal text-sm align-baseline">{from} {to ? (to != from ? `- ${to}` : "") : "- Present"}</span>{grade && <>&ensp;<span class="badge badge-ghost font-normal text-sm align-baseline">{grade}</span></>}
      </span>
    <p class="mt-1.5 text-justify">
      <slot />
    </p>
  </div>
</div>
